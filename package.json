{
  "name": "forge-obsidian",
  "version": "0.0.1",
  "description": "Forge is an AI learning companion for Obsidian with a pluggable agent runtime",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howlil/forge.git"
  },
  "homepage": "https://github.com/howlil/forge",
  "bugs": {
    "url": "https://github.com/howlil/forge/issues"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "deploy": "pnpm run build && node scripts/deploy.mjs",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ai",
    "learning"
  ],
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.6.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
